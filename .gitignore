# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com)
.grunt

# Bower dependency directory (https://bower.io)
bower_components

# node_modules (의존성 폴더 - 절대 커밋하지 않음)
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional webpack cache
.cache
.parcel-cache

# Optional REPL history
.node_repl_history

# Output of 'npm run build' or 'yarn build'
dist/
build/

# Environment variables (API 키, 비밀번호 등 보안 파일)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Mac OS System files
.DS_Store
