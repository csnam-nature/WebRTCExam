# 이 파일을 .env 로 복사해서 사용합니다.  (copy .env.example .env)
# .env 는 비밀값이 들어가므로 git 에 올리지 않습니다 (.gitignore 에 포함).

PORT=3000

# ---- HTTPS ----
# 다른 PC 에서 카메라를 쓰려면 HTTPS 가 필요합니다. (npm run start:https 와 같음)
# HTTPS=1
# 인증서를 지정하지 않으면 cert/ 에 자체 서명 인증서를 자동으로 만듭니다.
# mkcert 등으로 만든 인증서를 쓰려면 경로를 지정하세요.
# TLS_CERT=cert/mycert.pem
# TLS_KEY=cert/mycert-key.pem

# ---- STUN ----
# 쉼표로 여러 개 지정 가능. 값을 비우면(STUN_URLS=) STUN 을 쓰지 않습니다.
STUN_URLS=stun:stun.l.google.com:19302

# ---- TURN ----
# 비워 두면 TURN 을 쓰지 않습니다.
# 예) 로컬 coturn(Docker): turn:192.168.5.31:3478?transport=udp,turn:192.168.5.31:3478?transport=tcp
TURN_URLS=

# 방법 1) coturn static-auth-secret (권장)
#   turn/turnserver.conf 의 static-auth-secret 과 같은 값이어야 합니다.
#   서버가 접속할 때마다 TURN_TTL 초짜리 임시 자격증명을 만들어 브라우저에 줍니다.
TURN_SECRET=
TURN_TTL=3600

# 방법 2) 고정 계정 (TURN_SECRET 이 비어 있을 때만 사용. 관리형 TURN 서비스에서 받은 값 등)
TURN_USER=
TURN_PASS=
